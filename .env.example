# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.
# Los valores salen de Supabase → Project Settings → API (proyecto de desarrollo).

# Públicos: los puede ver el navegador. La seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-o-anon-key>

# Solo servidor (nunca con prefijo NEXT_PUBLIC_). Salta RLS: no usar en el cliente (RNF-02).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Opcional: correr `npm run test:db` contra una base DESECHABLE (inserta datos de prueba).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

{
  "name": "ciab-community",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:login-ui": "node --test tests/login-ui.test.mjs",
    "test:identity-api": "node --test tests/identity-api.test.mjs",
    "test:membership-api": "node --test tests/membership-api.test.mjs",
    "test:identity-unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/avatar-validation.test.mjs tests/identity-authorization.test.mjs tests/supabase-config.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
